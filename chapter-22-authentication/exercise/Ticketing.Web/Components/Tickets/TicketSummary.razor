<section>
    <strong>Totale:</strong> @Tickets.Count
    <strong>Priorità alta:</strong> @HighPriorityCount
    <strong>Più recente:</strong> @(NewestTicket?.ToString("dd/MM/yyyy HH:mm")
        ?? "nessuno")
</section>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<Ticket> Tickets { get; set; } = [];

    private int HighPriorityCount => Tickets.Count(ticket => ticket.Priority >= 3);

    private DateTimeOffset? NewestTicket => Tickets.Count == 0
        ? null
        : Tickets.Max(ticket => ticket.CreatedAt);
}
